# Copiar a .env en la raíz de TSE_NODOS y completar los valores vacíos
# antes de ejecutar Docker Compose. No incluir el .env real en Git.
# Este archivo configura los nodos locales; el panel tiene su propia configuración.

# Balanzas: las credenciales OAuth deben coincidir con las usadas por Central
# y con balanzasClientId / balanzasClientSecret del perfil local del panel.
BALANZAS_OAUTH_CLIENT_ID=componente-central
BALANZAS_OAUTH_CLIENT_SECRET=
# Clave de firma JWT de al menos 32 caracteres, distinta de la de Tracking.
BALANZAS_JWT_SECRET=
BALANZAS_OAUTH_TOKEN_TTL_SECONDS=3600

# Tracking: usar estas credenciales OAuth en trackingClientId /
# trackingClientSecret del perfil local del panel.
TRACKING_OAUTH_CLIENT_ID=tracking-admin
TRACKING_OAUTH_CLIENT_SECRET=
# Clave de firma JWT de al menos 32 caracteres.
TRACKING_JWT_SECRET=
TRACKING_OAUTH_TOKEN_TTL_SECONDS=3600
TRACKING_INTERVAL_SECONDS=5
TRACKING_SPEED_KMH=80

# RabbitMQ del componente central: copiar usuario y contraseña de TSE_CENTRAL/.env.
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# host.docker.internal apunta al host desde el contenedor; cambiar si Central es remoto.
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
# "true" para conectar por AMQPS (puerto 5671 por defecto); necesario si Central es remoto.
RABBITMQ_TLS=false

# PDI: contraseña administrativa obligatoria.
PDI_ADMIN_USER=admin
PDI_ADMIN_PASSWORD=
# Credenciales WS-Security: deben coincidir con las configuradas en Central.
PDI_ORGANISMO_CODIGO=MTOP-CARGA
# Clave de al menos 12 caracteres.
PDI_ORGANISMO_CLAVE=
PDI_ORGANISMO_NOMBRE="MTOP - carga.uy"
# Modos: NORMAL | LENTO | CAIDO. La latencia se aplica en modo LENTO.
PDI_SIMULACION_MODO=NORMAL
PDI_SIMULACION_LATENCIA_MS=0
PDI_WSS_TIMESTAMP_TTL_SEGUNDOS=300
