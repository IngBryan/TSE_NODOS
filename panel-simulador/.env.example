# Copiar a .env.local o inyectar en el contenedor. Nunca NEXT_PUBLIC_* para secretos.
PANEL_PASSWORD=reemplazar-con-una-clave-privada-de-12-caracteres-o-mas
PANEL_SESSION_SECRET=reemplazar-con-un-secreto-aleatorio-largo
PANEL_CONFIG_FILE=.local/profiles.json
PANEL_STATE_DIR=.local/state
# En cloud, el origen público exacto y cookies HTTPS:
# PANEL_PUBLIC_ORIGIN=https://panel.ejemplo.uy
# PANEL_COOKIE_SECURE=true
# Cada propiedad de profiles.json puede sobreescribirse con LOCAL_ o CLOUD_:
# LOCAL_CENTRAL_URL=http://localhost:8081/frontofficefuncionarios-web/api
# LOCAL_TRACKING_URL=http://localhost:3000
# LOCAL_BALANZAS_URL=http://localhost:3001
# LOCAL_API_KEY=...
# LOCAL_TRACKING_CLIENT_SECRET=...
# LOCAL_BALANZAS_CLIENT_SECRET=...
# Circulación y seguimiento: Montevideo–Maldonado (unos 132 km):
# LOCAL_DESTINATION=[-54.95,-34.9]
# LOCAL_LIVE_DESTINATION=[-54.95,-34.9]
# CLOUD_DESTINATION=[-54.95,-34.9]
# CLOUD_LIVE_DESTINATION=[-54.95,-34.9]
# Desvío por Palmitas: empalme de las rutas 2 y 105, sobre la calzada:
# LOCAL_WAYPOINT=[-57.817183,-33.5096]
# CLOUD_WAYPOINT=[-57.817183,-33.5096]
# Poller cloud: SSH al nodo directo, sin menús (valores por defecto):
# CLOUD_POLLER_MODE=ssh
# CLOUD_SSH_HOST=gate.elasticloud.uy
# CLOUD_SSH_PORT=3022
# CLOUD_SSH_USER=6255-648
# CLOUD_SSH_IDENTITY_FILE=~/.ssh/ale_id_ed25519
# CLOUD_SSH_KNOWN_HOSTS_FILE=~/.ssh/known_hosts
# Windows: rutas con /; usar comillas si contienen espacios, por ejemplo:
# CLOUD_SSH_IDENTITY_FILE="C:/Users/Mi usuario/.ssh/ale_id_ed25519"
# CLOUD_SSH_KNOWN_HOSTS_FILE="C:/Users/Mi usuario/.ssh/known_hosts"
# En Compose estas rutas dentro del contenedor son /app/ssh/identity y /app/ssh/known_hosts.
# Las rutas fuente del host se ajustan con PANEL_SSH_IDENTITY_FILE y PANEL_SSH_KNOWN_HOSTS_FILE
# en TSE_NODOS/.env o en el entorno que ejecuta Compose.
# Central local: Docker desde el host (valores predeterminados):
# LOCAL_POLLER_MODE=docker
# LOCAL_COMPOSE_FILE=/ruta/absoluta/TSE_CENTRAL/docker-compose.yml
# Windows: LOCAL_COMPOSE_FILE="C:/Mis proyectos/TSE_CENTRAL/docker-compose.yml"
# Por defecto se busca ../../TSE_CENTRAL/docker-compose.yml desde la carpeta del panel.
# Las rutas relativas del perfil y del entorno usan esa misma base en dev y npm start.
# El poller es obligatorio para la demo conjunta y exceso de carga; el diagnóstico bloquea si falta.
# El contenedor Compose del panel mantiene LOCAL_POLLER_MODE=disabled porque no monta el socket Docker.

# Seguimiento en vivo, separado del vehículo de desvío:
# LOCAL_LIVE_GUIDE_ID=GV-LT00001
# LOCAL_LIVE_PLATE=LT00001
# LOCAL_LIVE_GPS=100001
# CLOUD_LIVE_GUIDE_ID=GV-LT00001
# CLOUD_LIVE_PLATE=LT00001
# CLOUD_LIVE_GPS=100001
